# ============================================================
# KnowFlow AI — Frontend Production Environment Template
# ============================================================
# Copy this file to frontend/.env.local and fill in all values marked [REQUIRED].
# Never commit the actual .env.local file to version control.
# ============================================================

# ------------------------------------------------------------------ #
# Supabase (public — safe to expose to the browser)                  #
# ------------------------------------------------------------------ #
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co    # [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                         # [REQUIRED]

# ------------------------------------------------------------------ #
# Backend API URL                                                     #
# ------------------------------------------------------------------ #
NEXT_PUBLIC_API_URL=https://api.your-domain.com              # [REQUIRED]

# ------------------------------------------------------------------ #
# Next.js Output                                                      #
# Keep as 'standalone' for Docker/self-hosted deployments.            #
# Remove or set to '' for Vercel managed deployments.                 #
# ------------------------------------------------------------------ #
# (configured in next.config.mjs — not needed here as an env var)
