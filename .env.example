# =====================================================================
# KnowFlow AI - Master Environment Configuration Template
# =====================================================================
# IMPORTANT: Copy this file to .env or backend/.env / frontend/.env
# Never commit actual production credentials to source control.

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Backend Base URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration (Target: Supabase PostgreSQL + pgvector)
# Example: postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=company-documents

# AI Provider Abstraction (Configured in later phases)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
