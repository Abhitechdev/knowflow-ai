# =====================================================================
# KnowFlow AI - Backend Environment Template
# =====================================================================
ENVIRONMENT=development
DEBUG=True
PORT=8000

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector in production, unconfigured or local in development)
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Supabase Auth & Storage (Configured when live credentials are provided)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=company-documents

# AI Provider Abstraction (Configured in Phase 2 & 3)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
