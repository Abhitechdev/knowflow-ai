# ============================================================
# KnowFlow AI — Backend Production Environment Template
# ============================================================
# Copy this file to backend/.env and fill in all values marked [REQUIRED].
# Never commit the actual .env file to version control.
# ============================================================

# ------------------------------------------------------------------ #
# Application                                                         #
# ------------------------------------------------------------------ #
ENVIRONMENT=production
DEBUG=False
PORT=8000
PROJECT_NAME=KnowFlow AI
VERSION=0.1.0

# ------------------------------------------------------------------ #
# URLs (update to your actual domain)                                 #
# ------------------------------------------------------------------ #
BACKEND_URL=https://api.your-domain.com
FRONTEND_URL=https://your-domain.com

# ------------------------------------------------------------------ #
# CORS — explicit comma-separated allowlist, no wildcards             #
# ------------------------------------------------------------------ #
CORS_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]

# ------------------------------------------------------------------ #
# Database                                                            #
# Use transaction pooler (port 6543) for stateless API requests.     #
# Use direct connection (port 5432) for Alembic migrations only.     #
# ------------------------------------------------------------------ #
DATABASE_URL=postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:6543/[DBNAME]   # [REQUIRED]
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------ #
# Supabase                                                            #
# ------------------------------------------------------------------ #
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co    # [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                         # [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=eyJ...                             # [REQUIRED — keep SECRET]
STORAGE_BUCKET=company-documents

# ------------------------------------------------------------------ #
# AI Providers                                                        #
# ------------------------------------------------------------------ #
LLM_PROVIDER=openai
LLM_API_KEY=sk-...        # [REQUIRED]
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-...  # [REQUIRED]
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------ #
# Observability / Sentry (optional)                                   #
# Leave empty to disable Sentry error tracking.                      #
# ------------------------------------------------------------------ #
SENTRY_DSN=

# ------------------------------------------------------------------ #
# Uvicorn Worker Configuration                                        #
# WEB_CONCURRENCY: number of Uvicorn worker processes.               #
# Default: 2. Recommended: 2 × (CPU cores) + 1 for I/O-bound apps.  #
# ------------------------------------------------------------------ #
WEB_CONCURRENCY=2
